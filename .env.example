# Variáveis de ambiente do backoffice.
#
# Em produção NÃO se usa este ficheiro: os valores são definidos no Netlify em
# Project configuration → Environment variables. Aqui ficam só para consulta e
# para quem quiser correr localmente com valores próprios (copiar para .env,
# que está no .gitignore).

# ── Obrigatória ──────────────────────────────────────────
# Chave que assina os cookies de sessão. Trocar esta chave termina todas as
# sessões abertas. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Primeiro arranque ────────────────────────────────────
# Usada uma única vez, para criar a conta de administrador. No primeiro acesso
# o painel obriga a definir uma palavra-passe nova. Pode ser removida depois.
ADMIN_BOOTSTRAP_PASSWORD=

# Nome de utilizador da conta. Por omissão "admin".
# ADMIN_USERNAME=admin

# ── Reposição de palavra-passe ───────────────────────────
# Só definir quando for preciso repor a palavra-passe de um cliente que a
# perdeu. Definir, fazer redeploy, entrar com este valor (o painel obriga logo a
# trocá-la) e a seguir REMOVER a variável.
# ADMIN_PASSWORD_RESET=

    { nome: 'Crocantes de Camarão', desc: 'Com molho agridoce', preco: '5,50' },
    { nome: 'Pica-pau', desc: '', preco: '8,00' },
    { nome: 'Moelas', desc: '', preco: '8,00' },
  ],
  principais: [
    { nome: 'Frango de Churrasco', desc: '', preco: '9,00 / 14,00' },
    { nome: 'Posta à Moda da Casa', desc: '', preco: '16,00 / 28,50' },
    { nome: 'Misto de Carne', desc: '', preco: '15,50 / 19,50' },
    { nome: 'Costeletão de Vitela', desc: '', preco: '28,50' },
    { nome: 'Medalhões de Vitela', desc: '', preco: '16,00 / 28,50' },
    { nome: 'Panados com Arroz Malandrinho', desc: '', preco: '10,00 / 15,00' },
    { nome: 'Bifinhos de Perú com Cogumelos', desc: '', preco: '10,50 / 15,50' },
    { nome: 'Costelinhas de Porco Grelhadas', desc: '', preco: '10,50 / 16,00' },
    { nome: 'Legumes à Brás', desc: 'Prato vegetariano', preco: '12,00' },
  ],
  peixe: [
    { nome: 'Bacalhau com Natas', desc: '', preco: '12,00' },
    { nome: 'Bacalhau na Brasa', desc: '', preco: '22,50 / 36,00' },
    { nome: 'Bacalhau à Moda da Casa', desc: '', preco: '24,00' },
    { nome: 'Polvo à Lagareiro', desc: '', preco: '34,50' },
    { nome: 'Filetes de Pescada Dourados', desc: 'Com arroz malandrinho', preco: '10,00 / 15,00' },
    { nome: 'Salmão Grelhado', desc: '', preco: '14,50' },
    { nome: 'Dourada Grelhada', desc: '', preco: '13,00' },
    { nome: 'Robalo Grelhado', desc: '', preco: '14,00' },
    { nome: 'Sardinhas', desc: '', preco: '11,50' },

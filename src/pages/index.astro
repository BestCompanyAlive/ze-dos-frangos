  <script>
    // ── Carregar dados do Admin (localStorage) ──────────
    (function() {
      // --- siteGeral ---
      try {
        var geral = JSON.parse(localStorage.getItem('siteGeral') || '{}');
        var p1t = geral.sobreP1 || geral.sobre1;
        var p2t = geral.sobreP2 || geral.sobre2;
        if (p1t) { var p1 = document.getElementById('sobre-p1'); if (p1) p1.textContent = p1t; }
        if (p2t) { var p2 = document.getElementById('sobre-p2'); if (p2) p2.textContent = p2t; }
        // stats array format (from saveGeral)
        if (geral.stats && geral.stats.length) {
          geral.stats.forEach(function(s, i) {
            var v = document.getElementById('stat-val-' + (i+1)); if (v) v.textContent = s.val;
            var l = document.getElementById('stat-lbl-' + (i+1)); if (l) l.textContent = s.lbl;
          });
        } else {
          if (geral.stat1val) { var sv = document.getElementById('stat-val-1'); if (sv) sv.textContent = geral.stat1val; }
          if (geral.stat1lbl) { var sl = document.getElementById('stat-lbl-1'); if (sl) sl.textContent = geral.stat1lbl; }
          if (geral.stat2val) { var sv2 = document.getElementById('stat-val-2'); if (sv2) sv2.textContent = geral.stat2val; }
          if (geral.stat2lbl) { var sl2 = document.getElementById('stat-lbl-2'); if (sl2) sl2.textContent = geral.stat2lbl; }
          if (geral.stat3val) { var sv3 = document.getElementById('stat-val-3'); if (sv3) sv3.textContent = geral.stat3val; }
          if (geral.stat3lbl) { var sl3 = document.getElementById('stat-lbl-3'); if (sl3) sl3.textContent = geral.stat3lbl; }
        }
      } catch(e) {}

      // --- menuData ---
      try {
        var menu = JSON.parse(localStorage.getItem('menuData') || 'null');
        if (menu) {
          var catMap = { entradas: 'entradas', carnes: 'principais', peixe: 'peixe', sobremesas: 'sobremesas' };
          Object.keys(catMap).forEach(function(key) {
            var panelId = catMap[key];
            var panel = document.querySelector('[data-panel="' + panelId + '"]');
            if (!panel || !menu[key]) return;
            panel.innerHTML = '';
            menu[key].forEach(function(item) {
              var div = document.createElement('div');
              div.className = 'reveal flex justify-between items-baseline gap-4 py-4 border-b';
              div.style.borderColor = '#222';
              var descHtml = item.desc ? '<p class="text-gray-400 text-xs mt-0.5">' + item.desc + '</p>' : '';
              div.innerHTML = '<div><h3 class="text-white font-light text-sm">' + item.nome + '</h3>' + descHtml + '</div>' +
                '<span class="text-gold whitespace-nowrap text-sm shrink-0" style="font-family:Montserrat,sans-serif;">' + item.preco + ' €</span>';
              panel.appendChild(div);
            });
          });
        }
      } catch(e) {}

      // --- takeaway nota ---
      try {
        var ta = JSON.parse(localStorage.getItem('siteTakeaway') || '{}');
        if (ta.nota) {
          var notaEl = document.getElementById('takeaway-nota');
          var notaWrap = document.getElementById('takeaway-nota-wrap');
          if (notaEl && notaWrap) { notaEl.textContent = ta.nota; notaWrap.style.display = ''; }
        }
      } catch(e) {}

      // --- siteContactos ---
      try {
        var contactos = JSON.parse(localStorage.getItem('siteContactos') || '{}');
        if (contactos.telefone) {
          var phoneEl = document.getElementById('footer-telefone');
          if (phoneEl) phoneEl.textContent = contactos.telefone;
        }
        if (contactos.morada) {
          var moradaEl = document.getElementById('footer-morada');
          if (moradaEl) moradaEl.innerHTML = contactos.morada;
        }
      } catch(e) {}
    })();
  </script>

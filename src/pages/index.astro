---
import Layout from '../layouts/Layout.astro';

const menuData = {
  entradas: [
    { nome: 'Pão', desc: '', preco: '1,85' },
    { nome: 'Azeitonas e Azeite', desc: '', preco: '1,95' },
    { nome: 'Salsicha', desc: '', preco: '2,00' },
    { nome: 'Sopa do Dia', desc: '', preco: '2,00' },

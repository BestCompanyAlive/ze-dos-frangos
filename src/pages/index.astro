---

<Layout title="Churrasqueira Zé dos Frangos — Vila Real" description="Frango de churrasco grelhado no carvão em Vila Real. Especialidade da casa desde há décadas. Largo do Pioledo, nº 14, Vila Real.">
  <!-- NAV -->
  <nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-50 px-6 py-5"
    style="background: rgba(13,13,13,0.3); backdrop-filter: blur(4px);"
  >
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="#hero" class="flex items-center gap-3">
        <img src="/images/logo.png" alt="Zé dos Frangos" class="w-12 h-12 object-contain" />
        <div class="hidden sm:block text-left">
          <div class="text-gold text-xs tracking-[0.3em] uppercase" style="font-family: Playfair Display, serif;">Churrasqueira</div>
          <div class="text-xl font-light tracking-widest text-white">ZÉ DOS FRANGOS</div>
        </div>
      </a>

      <div class="hidden md:flex items-center gap-8" style="font-family: Playfair Display, serif;">
        <a href="#sobre" class="nav-link">Sobre</a>
        <a href="#ementa" class="nav-link">Ementa</a>
        <a href="#contactos" class="nav-link" onclick="document.getElementById('contactos').scrollIntoView({behavior:'smooth'});return false;">Contactos</a>
        <a href="#reservas" class="btn-gold" style="padding: 0.5rem 1.5rem; font-size: 0.7rem;">Reservar</a>
        <a href="#takeaway" class="btn-gold" style="padding: 0.5rem 1.5rem; font-size: 0.7rem; background: #c9a84c; color: #0d0d0d; border-color: #c9a84c;">Take Away</a>
      </div>

      <button id="menu-btn" class="md:hidden text-white" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden absolute top-full left-0 right-0 py-6 px-6 flex flex-col gap-5 text-center"
      style="background: rgba(13,13,13,0.97); font-family: Playfair Display, serif;"
    >
      <a href="#sobre" class="nav-link">Sobre</a>
      <a href="#ementa" class="nav-link">Ementa</a>
      <a href="#contactos" class="nav-link">Contactos</a>
      <a href="#reservas" class="nav-link text-gold">Reservar</a>
      <a href="#takeaway" class="nav-link" style="color: #c9a84c;">Take Away</a>
    </div>
  </nav>

  <!-- HERO -->
  <section
    id="hero"
    class="hero-bg relative flex items-center justify-center min-h-screen text-center px-6"
    style="background-image: url('/images/misto.jpg');"
  >
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.72) 100%);"></div>

    <div class="relative z-10 max-w-3xl">
      <img
        src="/images/logo.png"
        alt="Zé dos Frangos — Restaurante & Churrasqueira, desde 1996"
        class="mx-auto mb-8 w-32 h-32 md:w-40 md:h-40 object-contain"
        style="filter: drop-shadow(0 0 30px rgba(201,168,76,0.35));"
      />
      <p class="text-gold tracking-[0.4em] text-xs uppercase mb-6" style="font-family: Playfair Display, serif;">
        Vila Real · Trás-os-Montes
      </p>
      <h1 class="text-5xl md:text-7xl font-light text-white leading-tight mb-4">
        Churrasqueira<br /><em class="text-gold-light not-italic font-extralight">Zé dos Frangos</em>
      </h1>
      <div class="w-16 h-px bg-gold mx-auto my-6"></div>
      <p class="text-lg font-light text-gray-300 max-w-xl mx-auto leading-relaxed">
        O melhor frango grelhado no carvão de Vila Real. Uma tradição que se mantém fiel ao sabor autêntico de Trás-os-Montes.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#reservas" class="btn-gold">Reservar Mesa</a>
        <a href="#ementa" class="btn-gold" style="border-color: rgba(255,255,255,0.3); color: white;">Ver Ementa</a>
      </div>
    </div>

  </section>

  <!-- SOBRE NÓS -->
  <section id="sobre" class="py-28 px-6" style="background: #0d0d0d;">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
      <div class="reveal relative">
        <img
          src="/images/bacalhaunatas.jpg"
          alt="Frango grelhado no carvão"
          class="w-full h-96 object-cover"
          style="filter: brightness(0.9);"
        />
        <div class="absolute -bottom-6 -right-6 w-32 h-32 border border-gold hidden md:block" style="z-index: -1;"></div>
      </div>

      <div class="reveal">
        <p class="text-gold tracking-[0.3em] text-xs uppercase mb-4" style="font-family: Playfair Display, serif;">A Nossa História</p>
        <h2 class="text-4xl md:text-5xl font-light text-white leading-tight mb-6">
          Sabor Autêntico<br /><em class="text-gold-light not-italic">desde Sempre</em>
        </h2>
        <div class="w-12 h-px bg-gold mb-8"></div>
        <p id="sobre-p1" class="text-gray-400 leading-relaxed mb-5 font-light">
          No coração de Vila Real, a Churrasqueira Zé dos Frangos é uma referência gastronómica transmontana. O nosso frango grelhado lentamente no carvão, com piri-piri da casa, é a especialidade que faz as pessoas regressar geração após geração.
        </p>
        <p id="sobre-p2" class="text-gray-400 leading-relaxed font-light">
          Trabalhamos com produtos regionais de qualidade: frango do campo, carne mirandesa, legumes frescos. Uma cozinha simples, honesta e cheia de sabor — como sempre foi em Trás-os-Montes.
        </p>
        <div class="mt-10 grid grid-cols-3 gap-6 text-center">
          <div>
            <div id="stat-val-1" class="text-3xl font-light text-gold">30+</div>
            <div id="stat-lbl-1" class="text-xs text-gray-400 mt-1 tracking-wide" style="font-family: Playfair Display, serif;">Anos</div>
          </div>
          <div>
            <div id="stat-val-2" class="text-3xl font-light text-gold">Vila Real</div>
            <div id="stat-lbl-2" class="text-xs text-gray-400 mt-1 tracking-wide" style="font-family: Playfair Display, serif;">Localização</div>
          </div>
          <div>
            <div id="stat-val-3" class="text-3xl font-light text-gold">4.8★ Google</div>
            <div id="stat-lbl-3" class="text-xs text-gray-400 mt-1 tracking-wide" style="font-family: Playfair Display, serif;">Avaliação</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <div class="py-16 px-6 text-center" style="background: #111;">
    <p class="text-gold text-2xl md:text-3xl font-light italic">
      "Frango grelhado no carvão como o de antigamente."
    </p>
    <p class="text-gray-400 text-xs tracking-widest mt-3 uppercase" style="font-family: Playfair Display, serif;">
      — Churrasqueira Zé dos Frangos, Vila Real
    </p>
  </div>

  <!-- SUGESTÃO DO MÊS -->
  <div id="sugestao-mes-box" style="display:none;">
    <section style="position:relative; min-height: 480px; display:flex; align-items:stretch; overflow:hidden;">
      <!-- Foto -->
      <div id="sugestao-img-wrap" class="hidden md:block" style="width:50%; position:relative; min-height:480px; background:#111;">
        <img id="sugestao-img" src="" alt="Sugestão do Mês" style="width:100%; height:100%; object-fit:cover; display:block;" />
      </div>
      <!-- Conteúdo -->
      <div style="flex:1; background:#0d0d0d; display:flex; align-items:center; padding: 4rem 3rem; position:relative;">
        <div style="position:absolute; top:0; left:0; width:4px; height:100%; background: linear-gradient(to bottom, #c9a84c, rgba(201,168,76,0.1));"></div>
        <div style="max-width:480px;">
          <p class="text-gold text-xs tracking-[0.4em] uppercase mb-3" style="font-family: Playfair Display, serif;">Sugestão do Mês</p>
          <h2 id="sugestao-nome" class="text-4xl md:text-5xl font-light text-white leading-tight mb-4"></h2>
          <div style="width:40px; height:1px; background:#c9a84c; margin-bottom:1.5rem;"></div>
          <p id="sugestao-desc" class="text-gray-400 font-light leading-relaxed mb-6" style="font-size:1rem;"></p>
          <div style="display:flex; align-items:baseline; gap:1rem; flex-wrap:wrap;">
            <span id="sugestao-preco" class="text-gold text-3xl font-light" style="font-family: Playfair Display, serif;"></span>
            <a href="#reservas" class="btn-gold" style="font-size:0.7rem; padding:0.5rem 1.5rem;">Reservar Mesa</a>
          </div>
        </div>
      </div>
      <!-- Img mobile como background -->
      <div id="sugestao-img-mobile" class="md:hidden absolute inset-0" style="z-index:0; opacity:0.15;"></div>
    </section>
  </div>

  <!-- EMENTA -->
  <section id="ementa" class="py-28 px-6" style="background: #0d0d0d; position: relative; background-image: url('/images/polvo.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
    <div class="absolute inset-0" style="background: rgba(13,13,13,0.88);"></div>
    <div class="max-w-5xl mx-auto relative" style="z-index: 1;">
      <div class="text-center reveal mb-16">
        <p class="text-gold tracking-[0.3em] text-xs uppercase mb-4" style="font-family: Playfair Display, serif;">Os Nossos Pratos</p>
        <h2 class="text-4xl md:text-5xl font-light text-white">Ementa</h2>
        <div class="w-12 h-px bg-gold mx-auto mt-6"></div>
      </div>

      <!-- PRATO DO DIA -->
      <div id="prato-dia-box" class="reveal mb-12" style="display:none;">
        <div style="border: 1px solid rgba(201,168,76,0.4); background: rgba(201,168,76,0.06); border-radius: 4px; padding: 24px 32px;">
          <p class="text-gold text-xs tracking-[0.3em] uppercase mb-4" style="font-family: Playfair Display, serif;">Prato do Dia</p>
          <div id="prato-dia-lista" class="flex flex-col gap-3"></div>
          <p id="prato-dia-nota" class="text-gray-400 text-xs mt-4 font-light" style="display:none;"></p>
        </div>
      </div>

      <div class="flex justify-center gap-2 mb-12 flex-wrap">
        <button class="menu-tab active" data-tab="entradas">Entradas</button>
        <button class="menu-tab" data-tab="principais">Carnes</button>
        <button class="menu-tab" data-tab="peixe">Peixe</button>
        <button class="menu-tab" data-tab="sobremesas">Sobremesas</button>
      </div>

      {(['entradas','principais','peixe','sobremesas'] as const).map((cat, i) => (
        <div class="menu-panel grid md:grid-cols-2 gap-x-12" data-panel={cat} style={i > 0 ? 'display:none' : ''}>
          {menuData[cat].map((item) => (
            <div class="reveal flex justify-between items-baseline gap-4 py-4 border-b" style="border-color: #222;">
              <div>
                <h3 class="text-white font-light text-sm">{item.nome}</h3>
                {item.desc && <p class="text-gray-400 text-xs mt-0.5">{item.desc}</p>}
              </div>
              <span class="text-gold whitespace-nowrap text-sm shrink-0" style="font-family: Playfair Display, serif;">{item.preco} €</span>
            </div>
          ))}
        </div>
      ))}

      <p class="text-center text-gray-400 text-xs mt-10 tracking-wide" style="font-family: Playfair Display, serif;">
        IVA incluído à taxa em vigor · Ementa sujeita a alterações sazonais
      </p>
    </div>
  </section>

  <!-- RESERVAS -->
  <section id="reservas" class="py-28 px-6" style="position: relative; background-image: url('/images/croquetes.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
    <div class="absolute inset-0" style="background: rgba(13,13,13,0.88);"></div>
    <div class="max-w-2xl mx-auto relative" style="z-index: 1;">
      <div class="text-center reveal mb-14">
        <p class="text-gold tracking-[0.3em] text-xs uppercase mb-4" style="font-family: Playfair Display, serif;">Reserve a Sua Mesa</p>
        <h2 class="text-4xl md:text-5xl font-light text-white">Reservas</h2>
        <div class="w-12 h-px bg-gold mx-auto mt-6 mb-6"></div>
        <p class="text-gray-400 font-light">Confirmaremos a sua reserva por telefone. Também pode ligar para <span class="text-gold">259 322 212</span>.</p>
      </div>

      <!-- WhatsApp CTA -->
      <div class="reveal text-center mb-8">
        <a
          href="https://wa.me/351259322212?text=Olá,%20gostava%20de%20fazer%20uma%20reserva%20na%20Churrasqueira%20Zé%20dos%20Frangos."
          target="_blank"
          class="btn-gold"
          style="background: #25D366; border-color: #25D366; color: white; display: inline-flex; align-items: center; gap: 0.5rem;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Reservar via WhatsApp
        </a>
      </div>

      <div class="reveal text-center text-gray-400 text-xs mb-8 tracking-widest uppercase" style="font-family: Playfair Display, serif;">
        — ou preencha o formulário —
      </div>

      <!-- Aviso grupos grandes -->
      <div class="reveal mb-6 text-center">
        <p class="text-xs text-gray-400" style="font-family: Playfair Display, serif;">
          Reservas online disponíveis para <span class="text-gold font-semibold">grupos até 4 pessoas</span>.<br/>
          Para grupos maiores, contacte-nos por telefone ou WhatsApp.
        </p>
      </div>

      <!-- Aviso lotação / férias (oculto por defeito, ativado pelo admin) -->
      <div id="res-notice" class="reveal mb-6 hidden">
        <div style="border: 1px solid #c9a84c33; background: rgba(201,168,76,0.06); border-radius: 6px; padding: 16px; text-align: center;">
          <p id="res-notice-msg" class="text-gold text-sm font-light"></p>
        </div>
      </div>

      <form
        id="reserva-form"
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="reveal flex flex-col gap-4"
      >
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Nome</label>
            <input type="text" name="nome" placeholder="João Silva" class="form-input" required />
          </div>
          <div>
            <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Telefone</label>
            <input type="tel" name="telefone" placeholder="+351 912 345 678" class="form-input" required />
          </div>
        </div>
        <div>
          <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Email</label>
          <input type="email" name="email" placeholder="joao@email.com" class="form-input" required />
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Data</label>
            <input type="date" id="res-data" name="data" class="form-input" required />
          </div>
          <div>
            <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Hora</label>
            <select id="res-hora" name="hora" class="form-input" required>
              <option value="" style="background:#1a1a1a">Escolher</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Pessoas</label>
            <select name="pessoas" class="form-input" required>
              {['1','2','3','4'].map(n => (
                <option value={n} style="background:#1a1a1a">{n}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Aviso hora inválida -->
        <div id="hora-aviso" class="hidden" style="color:#c9a84c; font-size:12px; text-align:center; font-family:Montserrat,sans-serif; letter-spacing:0.05em;"></div>
        <!-- Aviso lotação -->
        <div id="lotacao-aviso" class="hidden" style="color:#ef4444; font-size:12px; text-align:center; font-family:Montserrat,sans-serif;"></div>

        <div>
          <label class="text-xs text-gray-400 tracking-widest uppercase block mb-2" style="font-family: Playfair Display, serif;">Observações</label>
          <textarea name="obs" placeholder="Alergias, ocasião especial, preferências..." class="form-input h-28 resize-none"></textarea>
        </div>
        <div class="text-center mt-4">
          <button type="submit" id="res-submit" class="btn-gold">Confirmar Reserva</button>
        </div>
      </form>

      <script>
        // ── Slots disponíveis e capacidade ──────────────────
        const SLOTS = {
          almoco:  ['11:30','12:00','12:30','13:00','13:30'],
          jantar:  ['19:00','19:30','20:00','20:30','21:00'],
        };
        const CAPACITY_PER_SLOT = 20; // pessoas por meia hora
        const CUTOFF_HOURS = 4;       // horas de antecedência
        const DINNER_START = 19;      // hora a partir da qual é jantar

        // Reservas já feitas (num sistema real viria de uma API)
        const bookedSlots: Record<string,number> = {};

        const dataInput  = document.getElementById('res-data') as HTMLInputElement;
        const horaSelect = document.getElementById('res-hora') as HTMLSelectElement;
        const aviso      = document.getElementById('hora-aviso') as HTMLElement;
        const lotacao    = document.getElementById('lotacao-aviso') as HTMLElement;
        const submitBtn  = document.getElementById('res-submit') as HTMLButtonElement;

        // Data mínima = hoje
        const today = new Date();
        dataInput.min = today.toISOString().split('T')[0];

        function populateSlots() {
          const dateVal = dataInput.value;
          horaSelect.innerHTML = '<option value="" style="background:#1a1a1a">Escolher</option>';
          aviso.classList.add('hidden');
          lotacao.classList.add('hidden');
          submitBtn.disabled = false;
          if (!dateVal) return;

          const now = new Date();
          const selected = new Date(dateVal + 'T00:00:00');
          const isToday = selected.toDateString() === now.toDateString();

          const allSlots = [...SLOTS.almoco, ...SLOTS.jantar];
          allSlots.forEach(slot => {
            const [hh, mm] = slot.split(':').map(Number);
            // Calcular cutoff: se jantar, cutoff = DINNER_START - CUTOFF_HOURS
            const cutoffHour = hh >= DINNER_START ? DINNER_START - CUTOFF_HOURS : 8;
            const slotDate = new Date(dateVal + `T${slot}:00`);
            const cutoffDate = new Date(dateVal + `T${String(cutoffHour).padStart(2,'0')}:00:00`);

            if (isToday && now >= cutoffDate) return; // passou o prazo

            const key = `${dateVal}_${slot}`;
            const ocupadas = bookedSlots[key] || 0;
            if (ocupadas >= CAPACITY_PER_SLOT) return; // slot cheio

            const opt = document.createElement('option');
            opt.value = slot;
            opt.style.background = '#1a1a1a';
            opt.textContent = slot + (ocupadas > 0 ? ` (${CAPACITY_PER_SLOT - ocupadas} lug. livres)` : '');
            horaSelect.appendChild(opt);
          });

          if (horaSelect.options.length === 1) {
            aviso.textContent = isToday
              ? 'Para reservas de hoje, o prazo já encerrou. Contacte-nos por telefone: 259 322 212.'
              : 'Não há horários disponíveis para esta data.';
            aviso.classList.remove('hidden');
            submitBtn.disabled = true;
          }
        }

        horaSelect.addEventListener('change', () => {
          lotacao.classList.add('hidden');
          const key = `${dataInput.value}_${horaSelect.value}`;
          const ocupadas = bookedSlots[key] || 0;
          if (ocupadas >= CAPACITY_PER_SLOT) {
            lotacao.textContent = 'Este horário já não tem disponibilidade. Escolha outro.';
            lotacao.classList.remove('hidden');
            submitBtn.disabled = true;
          } else {
            submitBtn.disabled = false;
          }
        });

        dataInput.addEventListener('change', populateSlots);
        populateSlots();

        // ── Submeter reserva via WhatsApp ───────────────────
        const form = document.getElementById('reserva-form') as HTMLFormElement;
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const nome     = (form.querySelector('[name="nome"]') as HTMLInputElement).value;
          const telefone = (form.querySelector('[name="telefone"]') as HTMLInputElement).value;
          const email    = (form.querySelector('[name="email"]') as HTMLInputElement).value;
          const data     = (form.querySelector('[name="data"]') as HTMLInputElement).value;
          const hora     = (form.querySelector('[name="hora"]') as HTMLSelectElement).value;
          const pessoas  = (form.querySelector('[name="pessoas"]') as HTMLSelectElement).value;
          const obs      = (form.querySelector('[name="obs"]') as HTMLTextAreaElement).value;

          const [ano, mes, dia] = data.split('-');
          const dataFmt = `${dia}/${mes}/${ano}`;

          let msg = `Olá! Gostaria de fazer uma reserva:\n\n`;
          msg += `👤 Nome: ${nome}\n`;
          msg += `📞 Telefone: ${telefone}\n`;
          msg += `📧 Email: ${email}\n`;
          msg += `📅 Data: ${dataFmt}\n`;
          msg += `🕐 Hora: ${hora}\n`;
          msg += `👥 Pessoas: ${pessoas}\n`;
          if (obs) msg += `📝 Obs: ${obs}\n`;

          // Guardar reserva no localStorage para o backoffice
          const reservas = JSON.parse(localStorage.getItem('reservas') || '[]');
          const novaReserva = {
            id: Date.now(),
            date: data,
            time: hora,
            name: nome,
            phone: telefone,
            email: email,
            guests: parseInt(pessoas),
            note: obs,
            status: 'pendente'
          };
          reservas.push(novaReserva);
          localStorage.setItem('reservas', JSON.stringify(reservas));

          const url = `https://wa.me/351259322212?text=${encodeURIComponent(msg)}`;
          window.open(url, '_blank');
        });
      </script>
    </div>
  </section>


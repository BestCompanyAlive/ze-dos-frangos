    { nome: 'Mousse de Oreo', desc: '', preco: '3,00' },
    { nome: 'Bolo de Bolacha', desc: '', preco: '3,00' },
    { nome: 'Doce do Dia', desc: '', preco: '3,50' },
    { nome: 'Molotof', desc: '', preco: '4,00' },
    { nome: 'Tiramissú', desc: '', preco: '4,00' },
    { nome: 'Baba de Camelo', desc: '', preco: '3,00' },
    { nome: 'Cheesecake', desc: '', preco: '4,00' },
    { nome: 'Fruta Variada', desc: '', preco: '2,50' },
  ],

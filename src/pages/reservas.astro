---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reservas — Churrasqueira Zé dos Frangos" description="Faça a sua reserva na Churrasqueira Zé dos Frangos em Vila Real.">
  <!-- NAV -->
  <nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-50 px-6 py-5"
    style="background: rgba(13,13,13,0.85); backdrop-filter: blur(4px); border-bottom: 1px solid rgba(255,255,255,0.05);"
  >
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/logo.png" alt="Zé dos Frangos" class="w-12 h-12 object-contain" />
        <div class="hidden sm:block text-left">
          <div class="text-gold text-xs tracking-[0.3em] uppercase" style="font-family: Playfair Display, serif;">Churrasqueira</div>
          <div class="text-xl font-light tracking-widest text-white">ZÉ DOS FRANGOS</div>
        </div>
      </a>

      <div class="hidden md:flex items-center gap-8" style="font-family: Playfair Display, serif;">
        <a href="/#sobre" class="nav-link">Sobre</a>
        <a href="/#ementa" class="nav-link">Ementa</a>
        <a href="/#contactos" class="nav-link">Contactos</a>
        <a href="/reservas" class="btn-gold" style="padding: 0.5rem 1.5rem; font-size: 0.7rem;">Reservar</a>
        <a href="/ajuda" class="nav-link">Apoio</a>
      </div>

      <button id="menu-btn" class="md:hidden text-white" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden absolute top-full left-0 right-0 py-6 px-6 flex flex-col gap-5 text-center"
      style="background: rgba(13,13,13,0.97); font-family: Playfair Display, serif;"
    >
      <a href="/#sobre" class="nav-link">Sobre</a>
      <a href="/#ementa" class="nav-link">Ementa</a>
      <a href="/#contactos" class="nav-link">Contactos</a>
      <a href="/reservas" class="nav-link text-gold">Reservar</a>
      <a href="/ajuda" class="nav-link">Apoio</a>
    </div>
  </nav>

  <!-- HERO RESERVAS -->
  <div style="min-height: 280px; background: #0d0d0d; display:flex; align-items:flex-end; padding: 7rem 1.5rem 3rem; position:relative; overflow:hidden;">
    <div style="max-width:700px; margin:0 auto; text-align:center; width:100%; position:relative; z-index:1;">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-3" style="font-family: Playfair Display, serif;">Churrasqueira Zé dos Frangos</p>
      <h1 class="text-4xl md:text-5xl font-light text-white" style="font-family: Playfair Display, serif;">Reserve a Sua Mesa</h1>
      <div style="width:40px;height:1px;background:#aea995;margin:1.5rem auto 0;"></div>
    </div>
  </div>

  <!-- RESERVAS INDISPONÍVEIS -->
  <section class="py-24 px-6" style="position:relative; min-height:calc(100vh - 280px); display:flex; align-items:center; background-image: url('/images/misto.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
    <div class="absolute inset-0" style="background: rgba(13,13,13,0.88);"></div>
    <div class="max-w-xl mx-auto text-center" style="position:relative; z-index:1; width:100%;">
      <p class="text-gold tracking-[0.3em] text-xs uppercase mb-4" style="font-family: Playfair Display, serif;">Reservas Online</p>
      <h2 class="text-3xl md:text-4xl font-light text-white mb-6">Brevemente Disponível</h2>
      <div style="width:40px;height:1px;background:#aea995;margin:0 auto 1.5rem;"></div>
      <p class="text-gray-400 font-light leading-relaxed mb-8">
        As reservas online estarão disponíveis brevemente. Para já, contacte-nos diretamente por telefone para reservar a sua mesa.
      </p>
      <a href="tel:+351913977751" class="btn-gold" style="display:inline-flex;align-items:center;gap:0.5rem;">
        Ligar para 913 977 751
      </a>
    </div>
  </section>
</Layout>

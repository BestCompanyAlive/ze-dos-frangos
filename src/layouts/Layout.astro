---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Casa do Sabor — Restaurante Português',
  description = 'Cozinha portuguesa tradicional com um toque contemporâneo. Reservas online disponíveis.',
} = Astro.props;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Sticky nav
      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          nav?.classList.add('nav-scrolled');
        } else {
          nav?.classList.remove('nav-scrolled');
        }
      });

      // Mobile menu
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });

      // Menu tabs
      const tabs = document.querySelectorAll('.menu-tab');
      const panels = document.querySelectorAll('.menu-panel');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = (tab as HTMLElement).dataset.tab;
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          panels.forEach((p) => {
            (p as HTMLElement).style.display =
              (p as HTMLElement).dataset.panel === target ? 'grid' : 'none';
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  #main-nav {
    transition: background 0.4s, box-shadow 0.4s;
  }
  #main-nav.nav-scrolled {
    background: rgba(13, 13, 13, 0.97) !important;
    box-shadow: 0 1px 30px rgba(0,0,0,0.5);
  }

  /* ── Mobile responsivo ── */
  .prato-precos-grid {
    grid-template-columns: 1fr 1fr 1fr;
  }

  @media (max-width: 480px) {
    .prato-precos-grid {
      grid-template-columns: 1fr;
    }

    /* Botões de reserva em coluna */
    #reservas .flex.flex-col.sm\:flex-row {
      flex-direction: column !important;
    }

    /* Notas prato do dia em coluna */
    #prato-dia-box .flex.flex-wrap {
      flex-direction: column;
    }

    /* Tabs ementa: scroll horizontal */
    #ementa .flex.justify-center.gap-2 {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 8px;
      scrollbar-width: none;
    }
    #ementa .flex.justify-center.gap-2::-webkit-scrollbar {
      display: none;
    }

    /* Estatísticas hero: 2 colunas em vez de 3 */
    .hero-stats {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 640px) {
    /* Padding reduzido nas secções */
    section.py-28 {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    /* Títulos grandes */
    h2.text-4xl {
      font-size: 2rem;
    }
  }
</style>

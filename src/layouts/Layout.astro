---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Casa do Sabor — Restaurante Português',
  description = 'Cozinha portuguesa tradicional com um toque contemporâneo. Reservas online disponíveis.',
} = Astro.props;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      // Exposto para conteúdo inserido mais tarde (ex: dados da base de dados,
      // carregados de forma assíncrona) poder registar-se no mesmo observador —
      // sem isto, esses elementos ficavam com opacidade 0 para sempre.
      window.__revealObserver = observer;

      // Sticky nav
      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          nav?.classList.add('nav-scrolled');
        } else {
          nav?.classList.remove('nav-scrolled');
        }
      });

      // Mobile menu
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });

      // Menu tabs
      const tabs = document.querySelectorAll('.menu-tab');
      const panels = document.querySelectorAll('.menu-panel');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = (tab as HTMLElement).dataset.tab;
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          panels.forEach((p) => {
            const el = p as HTMLElement;
            const active = el.dataset.panel === target;
            el.classList.toggle('active', active);
            el.setAttribute('aria-hidden', active ? 'false' : 'true');
          });
        });
      });

      // "Nudge" nos separadores da ementa: desliza um bocadinho e volta,
      // sempre que entram no ecrã — sem isto, o desvanecimento na margem é
      // uma pista passiva demais e só se nota depois de já se ter arrastado
      // por acidente. Limitado (máx. 3 vezes, no mínimo 4s entre cada) para
      // não ficar irritante em quem faz scroll para trás e para a frente.
      const ementaTabs = document.getElementById('ementa-tabs');
      if (ementaTabs) {
        let nudgeCount = 0;
        let lastNudge = 0;
        const nudgeObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const now = Date.now();
              if (nudgeCount >= 3 || now - lastNudge < 4000) return;
              nudgeCount += 1;
              lastNudge = now;
              ementaTabs.scrollTo({ left: 48, behavior: 'smooth' });
              setTimeout(() => ementaTabs.scrollTo({ left: 0, behavior: 'smooth' }), 500);
            });
          },
          { threshold: 0.5 }
        );
        nudgeObserver.observe(ementaTabs);
      }
    </script>
  </body>
</html>

<style is:global>
  #main-nav {
    transition: background 0.4s, box-shadow 0.4s;
  }
  #main-nav.nav-scrolled {
    background: rgba(13, 13, 13, 0.97) !important;
    box-shadow: 0 1px 30px rgba(0,0,0,0.5);
  }

  /* ── Mobile responsivo ── */
  .prato-precos-grid {
    grid-template-columns: 1fr 1fr 1fr;
  }

  @media (max-width: 480px) {
    .prato-precos-grid {
      grid-template-columns: 1fr;
    }

    /* Botões de reserva em coluna */
    #reservas .flex.flex-col.sm\:flex-row {
      flex-direction: column !important;
    }

    /* Notas prato do dia em coluna */
    #prato-dia-box .flex.flex-wrap {
      flex-direction: column;
    }

    /* Estatísticas hero: 2 colunas em vez de 3 */
    .hero-stats {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 640px) {
    /* Padding reduzido nas secções */
    section.py-28 {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    /* Títulos grandes */
    h2.text-4xl {
      font-size: 2rem;
    }
  }
</style>

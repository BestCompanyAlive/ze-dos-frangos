# Cabeçalhos de segurança. Este ficheiro é copiado para dist/ e lido pelo Netlify.
# As regras mais específicas somam-se às de /* (não as substituem).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# O painel nunca pode ficar em cache (é servido por trás do guarda de borda),
# nem ser indexado, nem ser carregado dentro de uma frame — sem frame-ancestors,
# um site terceiro podia sobrepor-lhe uma camada invisível e fazer o
# administrador carregar em botões sem dar por isso.
/admin.html
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'

/admin-login.html
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
